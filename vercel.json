{
  "rewrites": [
    { "source": "/api/prices", "destination": "/api/prices" },
    { "source": "/api/(.*)", "destination": "/api/server" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "crons": [
    { "path": "/api/cron/send-reports", "schedule": "0 10 * * *" },
    { "path": "/api/cron/apply-account-yield", "schedule": "0 11 * * *" },
    { "path": "/api/cron/generate-recurring", "schedule": "0 9 * * *" }
  ]
}
